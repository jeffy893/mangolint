# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=your-secret-key-here-change-in-production

# Mock Mode (set to true for demo without AWS credentials)
USE_MOCK_LINTER=false

# AWS Credentials
# boto3 will automatically use credentials from ~/.aws/credentials (default profile)
# If you want to use a specific profile, uncomment and set AWS_PROFILE below:
# AWS_PROFILE=your-profile-name

# Alternatively, you can set credentials directly (not recommended for security):
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# AWS Bedrock Configuration
BEDROCK_REGION=us-east-1
AWS_REGION=us-east-1

# Optional: Bedrock Model Configuration
# BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Production Settings (uncomment for production)
# FLASK_ENV=production
# DEBUG=False
